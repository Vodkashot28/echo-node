# EchoMesh Daemon Environment

# Leave SUPABASE_URL unset to use local SQLite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-key-here

# Node identity
USER_ID=default
NODE_NAME=EchoNode
NODE_REGION=auto
LISTEN_ADDR=0.0.0.0:3001

# SQLite (used when SUPABASE_URL is unset)
SQLITE_DB=sqlite:echo_node.db
