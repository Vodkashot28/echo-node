# EchoMesh Daemon Environment

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:pass@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Node identity
USER_ID=default
NODE_NAME=EchoNode
NODE_REGION=auto
LISTEN_ADDR=0.0.0.0:3001

# API key for /control and /settlements endpoints (optional — if set, requires Authorization: Bearer <key>)
# API_KEY=your-secret-key

# Target address for incoming tunnel relay (provider → target)
# RELAY_TARGET=127.0.0.1:80

# Tunnel listener bind address
# TUNNEL_ADDR=0.0.0.0:3002

# SQLite fallback (used when DATABASE_URL is unset)
SQLITE_DB=sqlite:echo_node.db

# Payout rate for verified receipts (USD per GB relayed)
# SETTLEMENT_RATE_USD_PER_GB=0.50

# Operating mode: provider (default) or consumer
# NODE_MODE=provider

# Consumer mode: local address local apps connect to, plus the provider
# node's tunnel address, libp2p PeerId, and base64 X25519 Noise key.
# CONSUMER_LISTEN_ADDR=127.0.0.1:3003
# PROVIDER_ADDR=provider.example.com:3002
# PROVIDER_PEER_ID=12D3KooW...
# PROVIDER_NOISE_PUBKEY=<base64 x25519 key — must decode to exactly 32 bytes>

# Dashboard telemetry bridge (opt-in, off by default) — pushes real heartbeat
# metrics to the echomesh control plane (Supabase report-telemetry edge function).
# See GAPS.md for the full integration roadmap.
# DASHBOARD_TELEMETRY_URL=https://<project>.supabase.co/functions/v1/report-telemetry
# DASHBOARD_TELEMETRY_TOKEN=<shared secret — must equal the function secret>
# DASHBOARD_USER_ID=<supabase auth user UUID that owns this node>
# DASHBOARD_NODE_ID=<optional stable UUID; auto-generated v4 if unset>
